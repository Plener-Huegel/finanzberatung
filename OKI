<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Kundenstammdaten sichern und OKI öffnen</title>
  <style>
    :root {
      font-family: "Open Sans", "Segoe UI", Arial, sans-serif;
      color: #4d4d4d;
      background: #f4f4f4;
      --gold: #ceb648;
      --gold-dark: #b99b22;
      --gold-pale: #f8f3dc;
      --charcoal: #4d4d4d;
      --muted: #666666;
      --line: #e2d8a5;
      --white: #ffffff;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      min-height: 100vh;
      margin: 0;
      padding: clamp(16px, 3vw, 34px);
      background: #f4f4f4;
    }

    main {
      width: min(100%, 1100px);
      margin: 0 auto;
      overflow: hidden;
      border: 1px solid #e4e4e4;
      border-radius: 8px;
      background: var(--white);
      box-shadow: 0 18px 50px rgba(77, 77, 77, 0.13);
    }

    .brand-bar {
      height: 8px;
      background: var(--gold);
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(310px, 0.7fr);
      gap: clamp(28px, 5vw, 58px);
      padding: clamp(34px, 6vw, 68px);
      background: linear-gradient(135deg, #d1bb4f, #c9ac3c);
    }

    .eyebrow {
      margin: 0 0 10px;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .hero .eyebrow { color: #ffffff; }

    h1 {
      max-width: 760px;
      margin: 0;
      color: #ffffff;
      font-size: clamp(2.15rem, 4.7vw, 3.4rem);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.025em;
    }

    .lead {
      max-width: 720px;
      margin: 24px 0 0;
      color: #ffffff;
      font-size: clamp(1rem, 2vw, 1.15rem);
      line-height: 1.7;
    }

    .context {
      margin-top: 26px;
      padding: 18px 20px;
      border-left: 5px solid #ffffff;
      background: rgba(255, 255, 255, 0.18);
      color: #ffffff;
      line-height: 1.6;
    }

    .launcher {
      align-self: start;
      padding: 28px;
      border: 1px solid rgba(77, 77, 77, 0.08);
      background: #ffffff;
      box-shadow: 0 14px 34px rgba(77, 77, 77, 0.15);
    }

    .launcher h2 {
      margin: 0 0 8px;
      color: var(--charcoal);
      font-size: 1.55rem;
      font-weight: 700;
    }

    .launcher p {
      margin: 0 0 22px;
      color: var(--muted);
      line-height: 1.55;
    }

    label {
      display: block;
      margin-bottom: 9px;
      color: var(--charcoal);
      font-weight: 700;
    }

    input {
      width: 100%;
      height: 62px;
      padding: 0 18px;
      border: 2px solid #c8c8c8;
      border-radius: 2px;
      outline: none;
      background: #ffffff;
      color: var(--charcoal);
      font: inherit;
      font-size: 1.45rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      transition: border-color 160ms ease, box-shadow 160ms ease;
    }

    input:focus {
      border-color: var(--gold-dark);
      box-shadow: 0 0 0 4px rgba(206, 182, 72, 0.22);
    }

    input[aria-invalid="true"] {
      border-color: #b3261e;
      box-shadow: 0 0 0 4px rgba(179, 38, 30, 0.10);
    }

    button {
      width: 100%;
      min-height: 56px;
      margin-top: 16px;
      border: 2px solid var(--gold-dark);
      border-radius: 2px;
      background: var(--gold);
      color: #ffffff;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      transition: background 120ms ease, color 120ms ease;
    }

    button:hover {
      background: #ffffff;
      color: var(--gold-dark);
    }

    button:focus-visible {
      outline: 4px solid rgba(206, 182, 72, 0.28);
      outline-offset: 3px;
    }

    .status {
      min-height: 22px;
      margin: 10px 2px 0;
      color: #b3261e;
      font-size: 0.9rem;
      line-height: 1.4;
    }

    .privacy {
      margin: 18px 0 0;
      padding-top: 16px;
      border-top: 1px solid #e7e7e7;
      color: #737373;
      font-size: 0.8rem;
      line-height: 1.45;
    }

    .instructions {
      padding: clamp(34px, 6vw, 68px);
      background: #ffffff;
    }

    .section-heading {
      max-width: 780px;
      margin-bottom: 34px;
    }

    .section-heading .eyebrow { color: var(--gold-dark); }

    .section-heading h2 {
      margin: 0;
      color: var(--charcoal);
      font-size: clamp(2rem, 4.5vw, 3.4rem);
      font-weight: 700;
      line-height: 1.12;
      letter-spacing: -0.025em;
    }

    .section-heading p {
      margin: 14px 0 0;
      color: var(--muted);
      line-height: 1.65;
    }

    .steps {
      display: grid;
      gap: 20px;
      margin: 0;
      padding: 0;
      list-style: none;
      counter-reset: steps;
    }

    .step {
      position: relative;
      padding: 26px 26px 26px 88px;
      border: 1px solid var(--line);
      background: #ffffff;
      counter-increment: steps;
    }

    .step::before {
      content: counter(steps);
      position: absolute;
      top: 24px;
      left: 24px;
      display: grid;
      width: 42px;
      height: 42px;
      place-items: center;
      background: var(--gold);
      color: #ffffff;
      font-weight: 700;
    }

    .step h3 {
      margin: 0 0 8px;
      color: var(--charcoal);
      font-size: 1.18rem;
      font-weight: 700;
    }

    .step p {
      margin: 0;
      color: var(--muted);
      line-height: 1.6;
    }

    figure {
      margin: 22px 0 0;
      padding: 14px;
      border: 1px solid #e6e1c6;
      overflow: hidden;
      background: #fafafa;
    }

    figure img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 0 auto;
    }

    figure.wide img { width: 100%; }
    figure.compact img { width: min(100%, 300px); }
    figure.export-icon img {
      width: 105px;
      image-rendering: auto;
    }

    figcaption {
      margin-top: 11px;
      color: #727272;
      font-size: 0.82rem;
      text-align: center;
    }

    .footer-note {
      margin-top: 28px;
      padding: 20px 22px;
      border-left: 5px solid var(--gold);
      background: var(--gold-pale);
      color: var(--charcoal);
      line-height: 1.6;
    }

    @media (max-width: 780px) {
      .hero { grid-template-columns: 1fr; }
      .step { padding: 24px 22px 24px 78px; }
      .step::before { left: 20px; }
    }

    @media (max-width: 520px) {
      body { padding: 0; }
      main { border: 0; border-radius: 0; }
      .hero, .instructions { padding: 30px 20px; }
      .launcher { padding: 24px 18px; }
      .step { padding: 76px 18px 22px; }
      .step::before { top: 18px; left: 18px; }
    }
  </style>
</head>
<body>
  <main>
    <div class="brand-bar" aria-hidden="true"></div>

    <section class="hero">
      <div>
        <p class="eyebrow">Arbeitsanweisung für Vermögensberater</p>
        <h1>Wichtige Kundenstammdaten sichern</h1>
        <p class="lead">Bitte selektiert und sichert alle wichtigen Kundenstammdaten aus der (O)KI. So steht euch bei Bedarf eine übersichtliche Kundenliste mit den wichtigsten Informationen zur Verfügung.</p>
        <div class="context"><strong>Hintergrund:</strong> Es ist noch nicht abschließend geklärt, ob das Selektionsmodul zum 11.11. abgeschaltet und durch die Funktion in Salesforce ersetzt wird. In Salesforce sind aktuell nur zehn Ausgabefelder vorgesehen.</div>
      </div>

      <div class="launcher">
        <h2>Selektion öffnen</h2>
        <p>Öffnet zuerst das DVAG-System. Gebt anschließend eure siebenstellige VB-Nummer ein. Die (O)KI wird automatisch geöffnet.</p>
        <form id="oki-form" novalidate>
          <label for="vb-number">VB-Nummer</label>
          <input
            id="vb-number"
            name="vb-number"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            maxlength="7"
            pattern="[0-9]{7}"
            placeholder="1234567"
            aria-describedby="status privacy"
            autofocus
          >
          <button type="submit">Selektion in der (O)KI öffnen</button>
          <p class="status" id="status" role="alert" aria-live="polite"></p>
        </form>
        <p class="privacy" id="privacy">Die VB-Nummer wird ausschließlich für den (O)KI-Aufruf verwendet und nicht gespeichert.</p>
      </div>
    </section>

    <section class="instructions" aria-labelledby="anweisung">
      <div class="section-heading">
        <p class="eyebrow">Schritt für Schritt</p>
        <h2 id="anweisung">Arbeitsanweisung</h2>
        <p>Führt die folgenden Schritte vollständig durch und speichert die Ergebnisdatei so, dass ihr sie später sicher wiederfindet.</p>
      </div>

      <ol class="steps">
        <li class="step">
          <h3>DVAG-System öffnen</h3>
          <p>Öffnet zuerst das DVAG-System auf eurem Arbeitsplatz.</p>
        </li>
        <li class="step">
          <h3>Diese HTML-Datei öffnen</h3>
          <p>Öffnet anschließend diese Datei im Browser.</p>
        </li>
        <li class="step">
          <h3>VB-Nummer eingeben</h3>
          <p>Gebt eure siebenstellige VB-Nummer oben ein. Sobald die Eingabe vollständig ist, öffnet sich die vorbereitete Selektion automatisch in der (O)KI.</p>
        </li>
        <li class="step">
          <h3>Ausgabeparameter prüfen</h3>
          <p>Prüft die vorgesehenen Ausgabeparameter. Ihr könnt die Felder bei Bedarf noch verändern.</p>
          <figure class="wide">
            <img src="data:image/png;base64," alt="Screenshot der Ausgabeparameter in der OKI">
            <figcaption>Screenshot 1: Ausgabeparameter prüfen und bei Bedarf anpassen</figcaption>
          </figure>
        </li>
        <li class="step">
          <h3>Selektion ausführen</h3>
          <p>Klickt anschließend auf „Selektion ausführen“ und wartet, bis die Ergebnisliste vollständig aufgebaut ist.</p>
          <figure class="compact">
            <img src="data:image/png;base64," alt="Schaltfläche Selektion ausführen">
            <figcaption>Screenshot 2: Selektion starten</figcaption>
          </figure>
        </li>
        <li class="step">
          <h3>Excel-Datei sicher speichern</h3>
          <p>Klickt auf das blaue Export-Symbol. Speichert die erzeugte Excel-Datei anschließend an einem sicheren Ort, an dem ihr sie bei Bedarf wiederfindet.</p>
          <figure class="export-icon">
            <img src="data:image/png;base64," alt="Blaues Export-Symbol der OKI">
            <figcaption>Screenshot 3: Export-Symbol anklicken</figcaption>
          </figure>
        </li>
      </ol>

      <div class="footer-note"><strong>Wichtig:</strong> Prüft nach dem Export, ob sich die Excel-Datei öffnen lässt und ob die benötigten Kundendaten vollständig enthalten sind.</div>
    </section>
  </main>

  <script>
    (() => {
      "use strict";

      const form = document.getElementById("oki-form");
      const input = document.getElementById("vb-number");
      const status = document.getElementById("status");
      const jumpInfo = "T0tJOi8vc2VsZWt0aW9uZW4vc2VsZWt0aW9uP3NlbGVrdGlvbmF1ZnRyYWdpZD0xNTk3MDMyMSZzaWc9bWFjMjcwNEU0RkIzQUQyNjgxRjUwQTJENEIyQzg2MzRGRDhGRjM0";
      let lastOpenedNumber = "";

      function buildOkiUrl(vbNumber) {
        const params = new URLSearchParams({
          cu: vbNumber,
          ja: "KI",
          j: "Basis.Jumper.jumpinfo",
          jumpinfo: jumpInfo
        });

        return "dvagsc://linkparams/?" + params.toString();
      }

      function openOki() {
        const vbNumber = input.value.replace(/\D/g, "");

        if (!/^\d{7}$/.test(vbNumber)) {
          input.setAttribute("aria-invalid", "true");
          status.textContent = "Bitte gebt eine siebenstellige VB-Nummer ein.";
          return;
        }

        input.removeAttribute("aria-invalid");
        status.textContent = "(O)KI wird geöffnet …";
        lastOpenedNumber = vbNumber;
        window.location.href = buildOkiUrl(vbNumber);
      }

      input.addEventListener("input", () => {
        const digitsOnly = input.value.replace(/\D/g, "").slice(0, 7);
        input.value = digitsOnly;
        input.removeAttribute("aria-invalid");
        status.textContent = "";

        if (digitsOnly.length === 7 && digitsOnly !== lastOpenedNumber) {
          openOki();
        }
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        openOki();
      });
    })();
  </script>
</body>
</html>

